{
  "manifest_version": 3,
  "name": "Read Selection Aloud",
  "version": "1.2.0",
  "description": "Reads selected text aloud from the context menu using Chrome's built-in text-to-speech engine.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "contextMenus",
    "tts",
    "storage"
  ],
  "action": {
    "default_title": "Read Selection Aloud settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "service-worker.js"
  }
}
